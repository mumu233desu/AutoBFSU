# ====================================================================
# AutoBFSU 本地安全配置文件示例 (复制为 .env 并填写您的真实配置信息)
# ====================================================================

# 1. 统一身份认证登录凭证 (用于数字北外通知拉取)
BFSU_USERNAME=YOUR_BFSU_USERNAME_HERE
BFSU_PASSWORD=YOUR_BFSU_PASSWORD_HERE

# 2. 信科学院教学平台登录凭证 (与数字北外完全解耦)
BFSU_STUDENT_ID=YOUR_STUDENT_ID_HERE
SIS_PASSWORD=YOUR_SIS_PASSWORD_HERE

# 3. LLM AI 通知总结服务配置 (可选，如不需要可留空，将自动降级为传统规则提取)
# 支持 OpenAI, DeepSeek, Ollama 等兼容格式 of API 接口
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 用户关注的相关性关键字 (用英文逗号分隔，推荐使用与自身学业/活动高度相关的词)
NOTIFICATION_KEYWORDS=选课,签到,考试,放假,学分,讲座,实训,成绩

# 4. 功能模块推送开关 (设置为 True 开启，False 关闭)
ENABLE_PORTAL_CHECK=True
ENABLE_BB_CHECK=True
ENABLE_CS_CHECK=True
